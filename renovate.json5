// Renovate keeps uv.lock, the Docker base images and the GitHub Actions pins current. It runs
// self-hosted from .github/workflows/renovate.yml (daily, with the RENOVATE_TOKEN secret).
//
// No pull requests: each update goes to a renovate/... branch, CI (tests, lint, both images built and
// smoke-tested, the dashboard queries) runs there, and Renovate merges it into main itself once CI
// passes. A failing update stays on its branch and shows on the Dependency Dashboard issue. Merged
// updates ship with the next release tag; nothing is released automatically.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: ['config:recommended'],
  timezone: 'America/New_York',

  // pyproject.toml + uv.lock (and the build backend), the Dockerfiles, workflow actions, and the
  // Renovate version the workflow runs. deploy/compose.yaml only names our own images.
  enabledManagers: ['pep621', 'dockerfile', 'github-actions', 'custom.regex'],

  // Let a release age a week first, so early regressions surface before it lands here.
  minimumReleaseAge: '7 days',
  internalChecksFilter: 'strict',

  automerge: true,
  automergeType: 'branch',

  // Weekly refresh of uv.lock's transitive dependencies, merged the same way.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
    schedule: ['* 0-5 * * 1'],
  },

  labels: ['dependencies'],

  customManagers: [
    {
      customType: 'regex',
      description: 'The Renovate version the workflow runs',
      managerFilePatterns: ['/^\\.github/workflows/renovate\\.yml$/'],
      matchStrings: ['renovate-version: (?<currentValue>\\d+\\.\\d+\\.\\d+)'],
      depNameTemplate: 'ghcr.io/renovatebot/renovate',
      datasourceTemplate: 'docker',
    },
  ],

  packageRules: [
    {
      description: 'A new Python in the images (3.14 to 3.15) is a bigger step than Docker\'s "minor" label suggests: a pull request to review, not merged automatically',
      matchDatasources: ['docker'],
      matchPackageNames: ['python'],
      matchUpdateTypes: ['major', 'minor'],
      automerge: false,
    },
    {
      description: 'Renovate itself releases daily: one combined update a month for it and its GitHub Action is plenty',
      matchPackageNames: ['ghcr.io/renovatebot/renovate', 'renovatebot/github-action'],
      groupName: 'Renovate',
      schedule: ['* 0-5 1 * *'],
    },
  ],
}
