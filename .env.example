# Copy to .env and fill in. Never commit .env.

# Optional: the thermostat provider (default nest, the only one so far).
# THERMOSTAT_PROVIDER=nest

# Home location for weather, rounded to 2 decimals (~1 km) before use
HOME_LATITUDE=
HOME_LONGITUDE=
# Optional: the home timezone (an IANA name) for local days in the SQL views. Default UTC.
# CLIMATECTL_TIMEZONE=America/New_York
# Optional: where the database goes. Default data/climatectl.db next to this file.
# CLIMATECTL_DB=
# Optional: indoor temperatures that alert whatever the mode, each with its unit (F or C).
# ALERT_FLOOR=55F
# ALERT_CEILING=86F

# Optional: a healthchecks.io (or similar) ping URL. The logger pings it after every cycle,
# and the service emails you if the pings stop. Treat it as a secret.
HEALTHCHECK_URL=

# Docker (deploy/compose.yaml): the password for Grafana's `admin` user, read when Grafana
# first starts. Optional: the port Grafana listens on (default 3000) and the release to run
# (default the one compose.yaml names).
GRAFANA_ADMIN_PASSWORD=
# GRAFANA_PORT=3000
# CLIMATECTL_VERSION=0.2.0

# Optional: Pushover (https://pushover.net) for HVAC fault and stopped-data alerts. Create an
# application for the token. The user key can be your own, or a delivery group's so each
# phone acknowledges separately. Allow Critical Alerts in the Pushover app so urgent alerts
# sound through silent mode. Treat both as secrets.
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# --- Nest provider ---
# Google Cloud project id (not the Device Access project id)
GCP_PROJECT_ID=
# OAuth 2.0 client (Web application, redirect URI https://www.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Written by `climatectl nest-auth`
GOOGLE_REFRESH_TOKEN=
# Device Access Console project id (a UUID)
SDM_PROJECT_ID=
# Optional: the Pub/Sub pull subscription for SDM events. Defaults to
# projects/$GCP_PROJECT_ID/subscriptions/sdm-events-pull.
# PUBSUB_SUBSCRIPTION=
